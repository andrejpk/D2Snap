{
  "name": "@perception-bench/harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r --filter \"./stacks/*\" --if-present typecheck",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:browser": "node --experimental-strip-types --test --test-concurrency=1 \"browser-tests/*.test.ts\"",
    "matrix": "node --experimental-strip-types src/print-matrix.ts",
    "demo": "node --experimental-strip-types src/runner/cli.ts",
    "report": "node --experimental-strip-types src/runner/rebuild-report.ts",
    "serve": "node --experimental-strip-types src/runner/serve.ts",
    "check": "pnpm typecheck && pnpm test && pnpm matrix"
  },
  "dependencies": {
    "@perception-bench/scenarios": "workspace:*",
    "@truto/turndown-plugin-gfm": "1.0.3",
    "dom-accessibility-api": "0.7.0",
    "jsdom": "22.1.0",
    "marked": "15.0.12",
    "turndown": "7.2.4",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@codemirror/lang-html": "6",
    "@codemirror/language": "6",
    "@codemirror/state": "6",
    "@codemirror/view": "6",
    "@lezer/highlight": "1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "prettier": "3",
    "typescript": "6.0.3"
  }
}
